# API root, including /api/v1. Use your computer's LAN IP on a physical phone.
# Keep this address in sync with the computer running HomeMadeApi.
EXPO_PUBLIC_API_URL=http://192.168.0.104:3000/api/v1

# Google Sign-In (needs a development build, not Expo Go). Public IDs only, never a secret.
# Web client ID: the audience the API verifies, also used by Android.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=922271245014-t4chlnd9j1e1bhjnsamta01a49aqa8tc.apps.googleusercontent.com
# iOS client ID: also sets the iOS URL scheme in app.config.ts.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=922271245014-t4chlnd9j1e1bhjnsamta01a49aqa8tc.apps.googleusercontent.com
